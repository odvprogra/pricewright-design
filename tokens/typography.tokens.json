{
  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": {
        "$value": ["Source Serif 4", "Georgia", "Cambria", "Times New Roman", "serif"],
        "$description": "Ledger's headings and customer-facing documents; never in tables or forms."
      },
      "sans": {
        "$value": ["Public Sans", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "The interface, tables and every amount (with tabular figures)."
      },
      "heading": {
        "$value": "{font.family.serif}",
        "$description": "Headings from the xl size up, and document titles."
      },
      "body": {
        "$value": "{font.family.sans}",
        "$description": "Everything else."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Eight steps from 12 to 36 px around a 16 px body; serif headings start at xl.",
      "xs": {
        "$value": { "value": 0.75, "unit": "rem" },
        "$description": "12 px: badges, footnotes."
      },
      "sm": {
        "$value": { "value": 0.875, "unit": "rem" },
        "$description": "14 px: tables, labels."
      },
      "md": { "$value": { "value": 1, "unit": "rem" }, "$description": "16 px: body text." },
      "lg": { "$value": { "value": 1.125, "unit": "rem" }, "$description": "18 px: lead text." },
      "xl": {
        "$value": { "value": 1.25, "unit": "rem" },
        "$description": "20 px: section headings."
      },
      "2xl": { "$value": { "value": 1.5, "unit": "rem" }, "$description": "24 px: page titles." },
      "3xl": {
        "$value": { "value": 1.875, "unit": "rem" },
        "$description": "30 px: document titles."
      },
      "4xl": {
        "$value": { "value": 2.25, "unit": "rem" },
        "$description": "36 px: the brand guide."
      }
    },
    "leading": {
      "$type": "number",
      "tight": { "$value": 1.2, "$description": "Headings." },
      "snug": { "$value": 1.35, "$description": "Table rows and dense lists." },
      "normal": { "$value": 1.5, "$description": "Running text." }
    }
  }
}
